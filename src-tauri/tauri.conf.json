{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grens",
  "version": "1.0.0",
  "identifier": "nl.wintrip.grens",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Grens",
        "width": 500,
        "height": 840,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "copyright": "Copyright 2026 Philip Wintrip",
    "shortDescription": "Vind rustige woorden om je grens aan te geven.",
    "longDescription": "Grens helpt je offline met korte zinnen om nee te zeggen, eigen teksten en een persoonlijk dagritme. Alles blijft op je apparaat.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "bundleVersion": "1",
      "files": {
        "Resources/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy"
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "bundleVersion": "1"
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    }
  }
}
